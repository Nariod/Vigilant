  <name>Secure Scratch</name>
  <summary>Ephemeral, encrypted scratch notes</summary>
  <description>
    <p>Secure Scratch is a note-taking application for temporary notes.
    Notes live only in memory, encrypted with ChaCha20-Poly1305 under a
    random session key, and are destroyed when the application closes.
    Nothing is ever written to disk.</p>
  </description>
  <launchable type="desktop-id">io.github.nariod.Vigilant.desktop</launchable>
  <url type="homepage">https://github.com/Nariod/Vigilant</url>
  <url type="bugtracker">https://github.com/Nariod/Vigilant/issues</url>
  <url type="donation">https://github.com/Nariod/Vigilant</url>
  <developer_name>Secure Scratch contributors</developer_name>
